{
  "name": "dsh-doubao-ui",
  "version": "1.1.0",
  "description": "豆包风格皮肤 for DeepSeek Harness Web：官方实测色板驱动的蓝调主题、大圆角几何、明暗双主题，外加品牌图标、首页快捷入口与关于页。纯 CSS 令牌覆盖 + 声明式插槽，零运行时依赖，不碰会话数据。",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": {
      "default": "./lib/index.mjs"
    },
    "./client": {
      "default": "./client/client.js"
    },
    "./tokens": {
      "default": "./src/tokens.mjs"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "client",
    "src",
    "assets",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node test/run-all.mjs",
    "prepublishOnly": "node scripts/build.mjs && node test/run-all.mjs"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "doubao",
    "豆包",
    "theme",
    "skin",
    "css-variables"
  ],
  "author": "JAKE1266 <3051975611@qq.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JAKE1266/dsh-doubao-ui.git"
  },
  "homepage": "https://github.com/JAKE1266/dsh-doubao-ui#readme",
  "bugs": {
    "url": "https://github.com/JAKE1266/dsh-doubao-ui/issues"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-brand-official"
      ]
    },
    "catalog": {
      "category": "theme",
      "summary": {
        "zh": "豆包风格皮肤：蓝调主色、大圆角几何、明暗双主题，外加品牌图标、首页快捷入口与关于页。",
        "en": "A Doubao-inspired skin for DSH Web: blue brand accent, rounded geometry, light/dark themes, plus brand marks, hero quick actions and an About page."
      },
      "capabilities": []
    }
  },
  "dependencies": {},
  "devDependencies": {}
}
